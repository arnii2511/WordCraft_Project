MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?appName=Cluster0
MONGODB_DB=wordcraft
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173
WORDCRAFT_ML_PROFILE=
WORDCRAFT_ENABLE_CONCEPTNET_RUNTIME=0
WORDCRAFT_ENABLE_RETRIEVAL=0
WORDCRAFT_DISABLE_CROSS_ENCODER=0
WORDCRAFT_DISABLE_SPACY=0
WORDCRAFT_DISABLE_TRANSFORMERS=0
